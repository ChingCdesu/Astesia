{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Astesia",
  "version": "1.0.8",
  "identifier": "com.astesia.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm mcp:prepare:debug && pnpm dev",
    "beforeBuildCommand": "pnpm mcp:prepare && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Astesia - Database Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": "all",
    "externalBin": [
      "binaries/astesia-mcp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ChingCdesu/Astesia/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBQTc2NzI4N0QxODhGNkMKUldSc2p4aDlLR2VuU3JscXVhVXM4cjhRbFBOOHo5UzJQcHBMTitHOWpaTXQwQStTc0plakwxL1MK"
    }
  }
}
